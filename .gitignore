# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
# AppleDouble resource-fork sidecars, created when a macOS tree is copied to a
# non-HFS volume (USB stick, zip, this Windows checkout). Junk on every platform.
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# Simulator
brain/gym-pybullet-drones/

# ROS node lockfiles are generated by colcon-ros-cargo at build time
brain/ros2_ws/src/*/Cargo.lock

# Docker build inputs: the *.npy/*.npz/detector.onnx rules above ignore the
# generated dataset, but the Dockerfile COPYs these three specific files (under
# brain/data/), so they must be tracked for a fresh clone to build the image. Tiny.
!brain/data/detector.onnx
!brain/data/trajectory.npy
!brain/data/layer2_isam2_results.npz

# Transient run outputs from the interactive scenario / benchmarks
brain/swarm_scenario.gif
brain/swarm_scenario_decisions.jsonl
brain/python_sender_latencies.csv

# hive_assist: figures and logs are regenerated by `make all`; the small ones
# that document a milestone are force-added per-file in the commit that adds them.
hive_assist/figures/*.gif
hive_assist/runs/

# Claude Code local session config (not part of the stack)
.claude/
