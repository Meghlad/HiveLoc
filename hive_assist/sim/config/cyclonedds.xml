<?xml version="1.0" encoding="UTF-8"?>
<!--
  D4.1 — Cyclone DDS tuning for 20 vehicles on one domain.

  All vehicles share ROS_DOMAIN_ID because the mesh requires them to see each
  other; namespaces keep the topics apart. The cost is a 20+ participant
  discovery table, and the default Cyclone settings spend real CPU on it. These
  three changes are the ones that matter at this scale:

    - restrict discovery to the swarm bridge interface, so the host's other
      NICs (wifi, docker0, tailscale) are not probed
    - raise the socket buffers, because 20 vehicles publishing pose at 50 Hz
      will drop fragments on the default 64 KB
    - lengthen the lease so a momentarily-swapped PX4 process is not declared
      dead, which at a 1-3 GB RAM headroom happens

  Anything that does NOT need to see the swarm — monitoring, rosbag replay, a
  second experiment — belongs on a DIFFERENT ROS_DOMAIN_ID. A stray stack on
  this domain inflates every participant's table.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">

    <General>
      <!-- the compose bridge network; override with CYCLONEDDS_NETWORK -->
      <NetworkInterfaceAddress>${CYCLONEDDS_NETWORK:-eth0}</NetworkInterfaceAddress>
      <AllowMulticast>true</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
      <FragmentSize>4000B</FragmentSize>
    </General>

    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <Watermarks>
        <WhcHigh>2MB</WhcHigh>
      </Watermarks>
      <!-- 20 SITL processes under memory pressure occasionally stall; do not
           mistake a swapped process for a dead one -->
      <LeaseDuration>10s</LeaseDuration>
    </Internal>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>40</MaxAutoParticipantIndex>
    </Discovery>

    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>

  </Domain>
</CycloneDDS>
