# Boot-time defaults for a GPS-denied, range-localised ArduCopter SITL instance.
#
# Layered ON TOP of ArduPilot's own Tools/autotest/default_params/copter.parm,
# which supplies the airframe (FRAME_CLASS/FRAME_TYPE), the RC calibration and
# the compass offsets. This file only carries what the restructured Domain 4
# changes.
#
# Everything here is also set over MAVLink at runtime by
# sim/external_nav_fanout.py (EXTNAV_PARAMS). The duplication is deliberate:
# setting them at boot means the EKF never starts up expecting a GPS and then
# has to be talked out of it, and setting them again at runtime means the loop
# works against a SITL instance somebody else launched. The two lists must
# agree; external_nav_fanout.py is the authority if they ever drift.

# --- the one that carries the thesis -------------------------------------
# GPS OFF. Section 1.3's observability argument -- that a surveyed anchor is
# what makes global translation observable -- is vacuous if a GPS is quietly
# supplying the answer.
GPS_TYPE        0
SIM_GPS1_ENABLE 0

# --- EKF3 source set ------------------------------------------------------
AHRS_EKF_TYPE   3
EK3_ENABLE      1
EK2_ENABLE      0
EK3_SRC1_POSXY  6
EK3_SRC1_VELXY  0
EK3_SRC1_POSZ   1
EK3_SRC1_VELZ   0
EK3_SRC1_YAW    1

# --- external nav (MAVLink VISION_POSITION_ESTIMATE) ----------------------
VISO_TYPE       1
VISO_POS_M_NSE  0.05
VISO_DELAY_MS   20

# --- geofence -------------------------------------------------------------
# OFF. The supervisor's geofence in sim/config/supervisor.json is the fence that
# matters, and it is checked BEFORE a setpoint is emitted rather than reacted to
# afterwards. Two fences with different shapes disagreeing mid-flight is a
# failure mode with no upside; the autopilot's is the one that goes.
FENCE_ENABLE    0

# --- SITL conveniences ----------------------------------------------------
# No radio on the desk, and no pilot to hold a switch.
SIM_RC_FAIL     0
BRD_SAFETYENABLE 0
# Log to file; the loop reads MAVLink, but a .bin is what you want when a flight
# does something surprising.
LOG_DISARMED    0
